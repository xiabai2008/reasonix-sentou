# ============================================================
# DawnForge 渗透作战工作台 — .gitignore
# ============================================================

# --- 大文件与工具二进制 ---
tools/**
!tools/run
!tools/brute.py
!tools/generate_html.py
!tools/generate_word.py
!tools/report_renderers/
!tools/rayscan/
!tools/poxiao/
!tools/dictx/
!tools/requirements.txt
# 说明：ccupp / super-password-dict / vulmap 为第三方内嵌 git 仓库，
# 按"工具本体不入库、部署时下载"原则整体忽略（见 scripts/setup-new-pc.ps1）。

# --- 超大字典库 ---
config/dictionaries/

# --- DawnForge 运行时数据 ---
.reasonix/

# --- WorkBuddy 会话记忆（本地专用，不上传远程） ---
.workbuddy/memory/

# --- 日志与临时文件 ---
clean/
tmp/
*.log
nul

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- 渗透结果（敏感数据） ---
result.txt
result.txt.realtime.tmp
flag.txt
*.flag
results/
evidence/
cases/**/evidence/
reports/*.html
reports/*.docx
reports/*.pdf
reports/*.md

# --- 个人/敏感数据（严禁提交到开源仓库） ---
ctf_exam_web01/
解题思路/
ctf_exam_*/
targets/data/
*.zip
*.docx
*.xlsx

# --- 前端预览/缓存产物 ---
.trae-html-share-packages/
*.har
*.pcap
*.pcapng
*.burp
*.sqlite
*.sqlite3
*.db
*.dump
*.kdbx

# --- 输出/工件 ---
.uploads/
.codegraph/
zip_from_git.zip
dist/
node_modules/

# --- 系统文件 ---
Thumbs.db
Desktop.ini
.DS_Store

# --- 敏感配置（含 API key 的环境文件） ---
.env
.env.local
*.secret

# --- 历史脚本归档（保留但不需要 Git 追踪） ---
archive/

# --- Agent 运行时目录（由 setup-agent-links.py 生成，勿入库） ---
.claude/
.codex/
.opencode/
.cline/
.cursor/
!templates/agent-configs/
!templates/agent-configs/.claude/
!templates/agent-configs/.claude/settings.example.json

# --- Docker & 靶场 ---
docker-compose.override.yml
targets/data/
