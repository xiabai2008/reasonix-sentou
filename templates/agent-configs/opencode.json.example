{
  "$schema": "https://opencode.ai/config.json",
  "name": "dawnforge-pentest",
  "description": "AI 渗透作战工作台 - 证据强制反幻觉 + 多 Agent 通用",
  "tools": {
    "bash": true,
    "web_search": true,
    "file_edit": true
  },
  "permissions": {
    "defaultMode": "ask",
    "ask": ["bash", "file_edit", "web_search"]
  },
  "context": {
    "systemPromptFile": "AGENTS.md",
    "skills": [".opencode/skill"],
    "maxOutputTokens": 16000
  },
  "model": {
    "default": "reasoner",
    "reasoning": true
  }
}